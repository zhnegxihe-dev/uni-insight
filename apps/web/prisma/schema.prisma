generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String
  nickname        String
  bio             String?
  avatarUrl       String?
  starScore       Int      @default(0)
  level           Int      @default(0)
  verifiedSchools String   @default("[]") // JSON: string[]
  identity        String   @default("{}") // JSON: {role,targetSchool,targetMajor,region}
  status          String   @default("active") // active | suspended | banned
  role            String   @default("user") // user | admin
  createdAt       DateTime @default(now())

  questions Question[]
  replies   Reply[]
  stars     ContentStar[]
  reviews   Review[]
  aiPosts   AiPost[]
  reports   Report[]
  actions       UserAction[]
  profile       UserProfile?
  notifications Notification[]
  following     Follow[]       @relation("follower")
  followers     Follow[]       @relation("following")
  conversationsA Conversation[] @relation("convA")
  conversationsB Conversation[] @relation("convB")
  messages      Message[]
}

model School {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  region      String?
  type        String?
  description String?
  verified    Boolean @default(false)

  courses  Course[]
  teachers Teacher[]
  reviews  Review[]
  domains  SchoolEmailDomain[]
}

model SchoolEmailDomain {
  id       String  @id @default(cuid())
  schoolId String
  domain   String  @unique
  verified Boolean @default(true)
  note     String?

  school School @relation(fields: [schoolId], references: [id])
}

model Major {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  category String?

  courses Course[]
  reviews Review[]
}

model Course {
  id       String  @id @default(cuid())
  schoolId String
  majorId  String?
  name     String
  code     String?

  school  School   @relation(fields: [schoolId], references: [id])
  major   Major?   @relation(fields: [majorId], references: [id])
  reviews Review[]

  @@unique([schoolId, code])
}

model Teacher {
  id         String  @id @default(cuid())
  schoolId   String
  name       String
  department String?
  title      String?

  school  School   @relation(fields: [schoolId], references: [id])
  reviews Review[]
}

model Question {
  id              String   @id @default(cuid())
  title           String
  description     String?
  authorId        String
  scenarioType    String
  scenarioMeta    String   @default("{}") // JSON
  degreeLevel     String?
  replyCount      Int      @default(0)
  starCount       Int      @default(0)
  acceptedReplyId String?
  isLocked        Boolean  @default(false)
  status          String   @default("visible") // visible | folded | hidden
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  author    User          @relation(fields: [authorId], references: [id])
  replies   Reply[]
  tags      QuestionTag[]
  aiSummary AiSummary?
  aiPosts   AiPost[]
}

model Reply {
  id         String   @id @default(cuid())
  questionId String
  authorId   String
  content    String
  starCount  Int      @default(0)
  isAccepted Boolean  @default(false)
  status     String   @default("visible") // visible | folded | hidden
  createdAt  DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id])
  author   User     @relation(fields: [authorId], references: [id])
}

model ContentStar {
  id         String   @id @default(cuid())
  userId     String
  targetType String // question | reply | ai_post
  targetId   String
  weight     Float    @default(1)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, targetType, targetId])
}

model Tag {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  type        String
  description String?

  questions QuestionTag[]
}

model QuestionTag {
  questionId String
  tagId      String

  question Question @relation(fields: [questionId], references: [id])
  tag      Tag      @relation(fields: [tagId], references: [id])

  @@id([questionId, tagId])
}

model Review {
  id           String   @id @default(cuid())
  authorId     String
  schoolId     String
  majorId      String?
  courseId     String?
  teacherId    String?
  degreeLevel  String?
  enrolledYear Int?
  isAlumni     Boolean  @default(false)
  ratings      String   @default("{}") // JSON
  content      String?
  status       String   @default("visible") // visible | folded | hidden
  createdAt    DateTime @default(now())

  author  User     @relation(fields: [authorId], references: [id])
  school  School   @relation(fields: [schoolId], references: [id])
  major   Major?   @relation(fields: [majorId], references: [id])
  course  Course?  @relation(fields: [courseId], references: [id])
  teacher Teacher? @relation(fields: [teacherId], references: [id])
}

model AiSummary {
  id             String   @id @default(cuid())
  questionId     String   @unique
  summaryJson    String
  sourceReplyIds String   @default("[]") // JSON
  version        Int      @default(1)
  isLocked       Boolean  @default(false)
  confidence     String?
  sampleNote     String?
  createdAt      DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id])
}

model AiPost {
  id               String    @id @default(cuid())
  authorId         String
  questionId       String?
  title            String
  summaryJson      String
  selectedReplyIds String    @default("[]") // JSON
  sourceCount      Int       @default(0)
  starCount        Int       @default(0)
  isHumanEdited    Boolean   @default(false)
  status           String    @default("published") // published | reviewing | rejected | folded | hidden
  createdAt        DateTime  @default(now())
  publishedAt      DateTime?

  author   User      @relation(fields: [authorId], references: [id])
  question Question? @relation(fields: [questionId], references: [id])
}

model UserAction {
  id         String   @id @default(cuid())
  userId     String
  actionType String // view | search | star | reply | post | verify
  targetType String? // question | school | major | tag | ...
  targetId   String?
  tags       String   @default("[]") // JSON: string[] 命中标签
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model UserProfile {
  userId    String   @id
  tagVector String   @default("{}") // JSON: Record<string, number> 标签向量
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // reply | accept | star | follow | report_result | system
  payload   String   @default("{}") // JSON
  readAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("follower", fields: [followerId], references: [id])
  following User @relation("following", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
  @@index([followingId])
}

model Conversation {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userA    User      @relation("convA", fields: [userAId], references: [id])
  userB    User      @relation("convB", fields: [userBId], references: [id])
  messages Message[]

  @@unique([userAId, userBId])
  @@index([userAId, updatedAt])
  @@index([userBId, updatedAt])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  readAt         DateTime?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])
  sender       User         @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
}

model Report {
  id            String   @id @default(cuid())
  reporterId    String
  targetType    String // question | reply | review | ai_post
  targetId      String
  targetOwnerId String?
  reason        String // ad | abuse | irrelevant | privacy
  detail        String?
  status        String   @default("open") // open | resolved | dismissed
  isValid       Boolean?
  rewardApplied Boolean  @default(false)
  createdAt     DateTime @default(now())

  reporter User @relation(fields: [reporterId], references: [id])

  @@unique([reporterId, targetType, targetId])
  @@index([status])
  @@index([targetType, targetId])
}
